rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function incoming() {
      return request.resource.data;
    }

    function isOwner() {
      return request.auth != null 
        && request.auth.token.email != null 
        && request.auth.token.email.matches('(?i)^6gb3sgbadm@gmail\\.com$');
    }

    function isValidReceipt(data) {
      return data.id is string
        && data.receiptNumber is string
        && data.consecutiveNumber is number
        && data.year is number
        && data.date is string
        && data.station is string
        && data.deliveredBy is string
        && data.status in ['pending', 'signed'];
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    match /receipts/{receiptId} {
      // Leitura pública para consulta no painel e leitura de QR Code em viaturas/postos
      allow read: if true;
      
      // Criação e atualização de recibos e assinaturas digitais
      allow create: if isValidReceipt(incoming());
      allow update: if isValidReceipt(incoming());

      // Exclusão protegida: restrita exclusivamente ao proprietário encarregado (6gb3sgbadm@gmail.com)
      allow delete: if isOwner();
    }

    match /stations/{stationId} {
      allow read: if true;
      allow write: if true;
    }

    match /materials/{materialId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
